# API base URL (used by axiosConfig.ts and attachment components)
#
# Must stay RELATIVE so requests hit the Vite dev proxy in vite.config.ts,
# which strips the Origin header before forwarding to Railway. Setting an
# absolute URL here bypasses the proxy entirely and triggers CORS errors.
VITE_API_URL=/api

# Bare server origin — used for <img>/download URLs and the socket.io
# handshake, none of which go through the /api proxy.
# VITE_API_BASE_URL=https://ticket-system-back-en-production.up.railway.app

# To test against the LOCAL backend (localhost:5000 + local MongoDB) keep
# VITE_API_URL relative and point the dev proxy at it instead:
#   npm run dev:local            (one-off)
#   or set VITE_PROXY_TARGET=http://localhost:5000 in .env.local (persistent)
# `npm run dev:prod` forces the production backend regardless of .env.local.
