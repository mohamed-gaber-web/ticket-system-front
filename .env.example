# Copy this file to .env and fill in the values

# Backend API base URL (with /api suffix)
VITE_API_URL=http://localhost:5000/api

# Backend base URL (without /api — used for attachment file URLs)
VITE_API_BASE_URL=http://localhost:5000

# Optional: explicit Socket.io server origin (without /api).
# Falls back to VITE_API_BASE_URL when unset.
# VITE_SOCKET_URL=http://localhost:5000

# Dev-server proxy target for /api and /socket.io (vite.config.ts).
# Leave unset to hit the PRODUCTION backend; set to test against a local
# backend + local MongoDB before deploying. Put it in .env.local (git-ignored)
# or just run `npm run dev:local` / `npm run dev:prod`.
# VITE_PROXY_TARGET=http://localhost:5000
